+    private static String stateKey(Identifier block, BlockState state) {
+        StringBuilder result = new StringBuilder(block.toString());
+        List<Property.Value<?>> values = state.getValues()
+                .sorted(Comparator.comparing(value -> value.property().getName())).toList();
+        if (!values.isEmpty()) {
+            result.append('[');
+            values.forEach(value -> result.append(value.property().getName()).append('=')
+                    .append(value.valueName()).append(','));
+            result.setCharAt(result.length() - 1, ']');
+        }
+        return result.toString();
+    }
