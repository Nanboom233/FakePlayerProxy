diff --git a/proxy/src/main/java/com/velocitypowered/proxy/protocol/util/FakePlayerProxyRelay.java b/proxy/src/main/java/com/velocitypowered/proxy/protocol/util/FakePlayerProxyRelay.java
new file mode 100644
index 00000000..227455b5
--- /dev/null
+++ b/proxy/src/main/java/com/velocitypowered/proxy/protocol/util/FakePlayerProxyRelay.java
@@ -0,0 +1,245 @@
+/*
