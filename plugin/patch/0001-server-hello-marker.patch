+  }
+
+  /**
+   * Creates an outbound response from ciphertext that the client produced for the target key.
+   *
+   * <p>The relay transforms the standard frontend response without decrypting target ciphertext.
+   * This constructor preserves the packet abstraction and avoids mutable ciphertext setters. The
+   * ordinary inbound decoder continues to use the empty constructor.
+   *
+   * @param sharedSecret the AES secret encrypted with the target public key
+   * @param verifyToken the original target challenge encrypted with the target public key
+   */
+  public EncryptionResponsePacket(byte[] sharedSecret, byte[] verifyToken) {
+    this.sharedSecret = sharedSecret.clone();
+    this.verifyToken = verifyToken.clone();
+  }
+
   public byte[] getSharedSecret() {
     return sharedSecret.clone();
   }
