 import com.velocitypowered.api.proxy.Player;
+import com.velocitypowered.api.proxy.ServerConnection;
 import org.geysermc.mcprotocollib.network.packet.Packet;
 
 /** A synchronous event for one packet received from a backend server. */
 public final class ClientboundPacketEvent<T extends Packet> {
   private final Player player;
+  private final ServerConnection source;
   private final Class<T> packetType;
   private T packet;
 
   /**
    * Creates a clientbound packet event.
    *
    * @param player the receiving player
+   * @param source the backend that supplied the packet
    * @param packetType the registered packet type
    * @param packet the decoded packet
    */
-  public ClientboundPacketEvent(Player player, Class<T> packetType, T packet) {
+  public ClientboundPacketEvent(
+      Player player, ServerConnection source, Class<T> packetType, T packet) {
     this.player = requireNonNull(player, "player");
+    this.source = source;
     this.packetType = requireNonNull(packetType, "packetType");
     this.packet = requireNonNull(packet, "packet");
   }
 
   public Player getPlayer() {
     return player;
   }
 
+  /**
+   * Returns whether the candidate is the backend that supplied this packet.
+   *
+   * @param candidate the backend to compare
+   * @return whether the candidate supplied this packet
+   */
+  public boolean isSource(ServerConnection candidate) {
+    return source == candidate;
+  }
+
   public T getPacket() {
     return packet;
   }
 
   public void setPacket(T packet) {
     this.packet = packetType.cast(requireNonNull(packet, "packet"));
   }
 }
