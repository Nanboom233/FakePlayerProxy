   private @org.checkerframework.checker.nullness.qual.Nullable Player packetPlayer(
       MinecraftConnectionAssociation association) {
     if (direction == ProtocolUtils.Direction.SERVERBOUND
         && association instanceof ConnectedPlayer player) {
