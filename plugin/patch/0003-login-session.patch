   /**
    * Joins the paused target to the frontend configuration stage.
    *
    * <p>Target Login Success arrived before Velocity registered the frontend
    * player. {@link AuthSessionHandler} first finishes LoginEvent, registration,
    * and PostLogin. {@link ClientConfigSessionHandler} also waits for the client
    * settings packet. It then calls this method on the backend event loop.
    *
    * <p>The method sends Login Acknowledged before it installs the existing target
    * config handler. It forwards the saved client settings and then resumes target
    * reads. Existing Velocity configuration code owns every later packet.
    *
    * @param settings the settings from the authenticated frontend client
    */
   public void resumeRelayConfiguration(ClientSettingsPacket settings) {
     MinecraftConnection backend = serverConn.ensureConnected();
     if (backend.getActiveSessionHandler() != this) {
       MinecraftSessionHandler activeHandler = backend.getActiveSessionHandler();
       logger.error(
           "Cannot resume target configuration: active backend handler is {}",
           activeHandler == null ? "absent" : activeHandler.getClass().getName());
       disconnectRelay();
       return;
     }
     final ChannelFuture responseWrite = relayResponseWrite;
     if (!backend.eventLoop().inEventLoop()) {
       logger.error("Cannot resume target configuration: caller is outside the backend event loop");
       disconnectRelay();
       return;
     }
     if (resultFuture.isDone()) {
       logger.error("Cannot resume target configuration: backend result is already complete");
       disconnectRelay();
       return;
     }
     if (backend.isAutoReading()) {
       logger.error("Cannot resume target configuration: backend reads are not paused");
       disconnectRelay();
       return;
     }
     if (responseWrite == null) {
       logger.error("Cannot resume target configuration: relay response write is absent");
       disconnectRelay();
       return;
     }
     if (!responseWrite.isSuccess()) {
       Throwable cause = responseWrite.cause();
       if (cause == null) {
         logger.error(
             "Cannot resume target configuration: relay response write state is {}",
             responseWrite);
       } else {
         logger.error("Cannot resume target configuration: relay response write failed", cause);
       }
       disconnectRelay();
       return;
     }
     if (backend.getChannel().pipeline().context(CIPHER_DECODER) == null) {
       logger.error("Cannot resume target configuration: backend cipher decoder is absent");
       disconnectRelay();
       return;
     }
 
     relayResponseWrite = null;
     backend.write(new LoginAcknowledgedPacket());
     backend.setActiveSessionHandler(
         StateRegistry.CONFIG, new ConfigSessionHandler(server, serverConn, resultFuture));
     backend.write(settings);
     server.getEventManager().fireAndForget(
         new PlayerEnteredConfigurationEvent(serverConn.getPlayer(), serverConn));
     backend.setAutoReading(true);
   }
 
   /** Closes the backend and completes its result with Velocity's stable connection error. */
   private void disconnectRelay() {
     clearTargetHello();
     relayResponseWrite = null;
     resultFuture.complete(ConnectionRequestResults.forDisconnect(
         ConnectionMessages.INTERNAL_SERVER_CONNECTION_ERROR, serverConn.getServer()));
     serverConn.disconnect();
