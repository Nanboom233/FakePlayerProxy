   @Override
   public boolean handle(EncryptionRequestPacket packet) {
+    MinecraftConnection frontend = serverConn.getPlayer().getConnection();
+    // Only the provisional initial login can relay an online target Server Hello.
+    if (frontend.getActiveSessionHandler() instanceof InitialLoginSessionHandler handler) {
+      if (resultFuture.isDone()) {
+        logger.error(
+            "Cannot accept target Server Hello for {}: backend result is already complete",
+            serverConn.getPlayer());
+        disconnectRelay();
+        return true;
+      }
+      if (relayResponseWrite != null) {
+        logger.error(
+            "Cannot accept target Server Hello for {}: a relay response write already exists",
+            serverConn.getPlayer());
+        disconnectRelay();
+        return true;
+      }
+      if (targetHello != null) {
+        logger.error(
+            "Cannot accept target Server Hello for {}: a pending target Hello already exists",
+            serverConn.getPlayer());
+        disconnectRelay();
+        return true;
+      }
+
+      this.targetHello = new TargetHello(packet.getPublicKey(), packet.getVerifyToken());
+      handler.handleBackendEncryptionRequest(serverConn, packet);
+      return true;
