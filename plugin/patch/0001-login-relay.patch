   @Override
   public boolean handle(ServerLoginSuccessPacket packet) {
     if (server.getConfiguration().getPlayerInfoForwardingMode() == PlayerInfoForwarding.MODERN && !informationForwarded) {
+      relayResponseWrite = null;
+      clearTargetHello();
       resultFuture.complete(ConnectionRequestResults.forDisconnect(MODERN_IP_FORWARDING_FAILURE, serverConn.getServer()));
       serverConn.disconnect();
       return true;
     }
 
+    MinecraftConnection frontend = serverConn.getPlayer().getConnection();
+    if (frontend.getActiveSessionHandler() instanceof InitialLoginSessionHandler handler) {
+      final MinecraftConnection backend = serverConn.ensureConnected();
+      ChannelFuture responseWrite = relayResponseWrite;
+      if (resultFuture.isDone()) {
+        logger.error(
+            "Cannot accept target Login Success for {}: backend result is already complete",
+            serverConn.getPlayer());
+        disconnectRelay();
+        return true;
+      }
+      if (responseWrite == null) {
+        logger.error(
+            "Cannot accept target Login Success for {}: relay response write is absent",
+            serverConn.getPlayer());
+        disconnectRelay();
+        return true;
+      }
+      if (!responseWrite.isSuccess()) {
+        Throwable cause = responseWrite.cause();
+        if (cause == null) {
+          logger.error(
+              "Cannot accept target Login Success for {}: relay response write state is {}",
+              serverConn.getPlayer(), responseWrite);
+        } else {
+          logger.error(
+              "Cannot accept target Login Success: relay response write failed for {}",
+              serverConn.getPlayer(), cause);
+        }
+        disconnectRelay();
+        return true;
+      }
+      if (targetHello != null) {
+        logger.error(
+            "Cannot accept target Login Success for {}: pending target Hello was not released",
+            serverConn.getPlayer());
+        disconnectRelay();
+        return true;
+      }
+      if (backend.getActiveSessionHandler() != this) {
+        MinecraftSessionHandler activeHandler = backend.getActiveSessionHandler();
+        logger.error(
+            "Cannot accept target Login Success for {}: active backend handler is {}",
+            serverConn.getPlayer(),
+            activeHandler == null ? "absent" : activeHandler.getClass().getName());
+        disconnectRelay();
+        return true;
+      }
+      if (backend.getChannel().pipeline().context(CIPHER_DECODER) == null) {
+        logger.error(
+            "Cannot accept target Login Success for {}: backend cipher decoder is absent",
+            serverConn.getPlayer());
+        disconnectRelay();
+        return true;
+      }
+
+      List<GameProfile.Property> properties = packet.getProperties();
+      UUID sessionId = packet.getSessionId();
+      if (properties == null) {
+        logger.error(
+            "Cannot accept target Login Success for {}: profile properties are absent",
+            serverConn.getPlayer());
+        disconnectRelay();
+        return true;
+      }
+      if (sessionId == null) {
+        logger.error(
+            "Cannot accept target Login Success for {}: Minecraft 26.2 session ID is absent",
+            serverConn.getPlayer());
+        disconnectRelay();
+        return true;
+      }
+
+      try {
+        GameProfile profile = new GameProfile(
+            packet.getUuid(), packet.getUsername(), properties);
+        // Stop target configuration until the frontend owns this authenticated identity.
+        backend.setAutoReading(false);
+        handler.handleBackendLoginSuccess(serverConn, profile, sessionId);
+      } catch (RuntimeException exception) {
+        logger.error(
+            "Cannot hand target Login Success to the frontend relay for {}",
+            serverConn.getPlayer(), exception);
+        disconnectRelay();
+      }
+      return true;
+    }
+
     // The player has been logged on to the backend server, but we're not done yet. There could be
     // other problems that could arise before we get a JoinGame packet from the server.
 
     // Move into the PLAY phase.
     MinecraftConnection smc = serverConn.ensureConnected();
     if (smc.getProtocolVersion().lessThan(ProtocolVersion.MINECRAFT_1_20_2)) {
       smc.setActiveSessionHandler(StateRegistry.PLAY, new TransitionSessionHandler(server, serverConn, resultFuture));
     } else {
       smc.write(new LoginAcknowledgedPacket());
       smc.setActiveSessionHandler(StateRegistry.CONFIG, new ConfigSessionHandler(server, serverConn, resultFuture));
       ConnectedPlayer player = serverConn.getPlayer();
       if (player.getClientSettingsPacket() != null) {
         smc.write(player.getClientSettingsPacket());
       }
       if (player.getConnection().getActiveSessionHandler() instanceof ClientPlaySessionHandler clientPlaySessionHandler) {
         smc.setAutoReading(false);
         clientPlaySessionHandler.doSwitch().thenRunAsync(() -> smc.setAutoReading(true), smc.eventLoop());
       } else {
         // Initial login - the player is already in configuration state.
         server.getEventManager().fireAndForget(new PlayerEnteredConfigurationEvent(player, serverConn));
       }
     }
 
     return true;
   }
 
   @Override
   public boolean handle(ClientboundStoreCookiePacket packet) {
     throw new IllegalStateException("Can only store cookie in CONFIGURATION or PLAY protocol");
   }
 
   @Override
   public boolean handle(ClientboundCookieRequestPacket packet) {
     server.getEventManager().fire(new CookieRequestEvent(serverConn.getPlayer(), packet.getKey()))
         .thenAcceptAsync(event -> {
           if (event.getResult().isAllowed()) {
             final Key resultedKey = event.getResult().getKey() == null
                 ? event.getOriginalKey() : event.getResult().getKey();
 
             serverConn.getPlayer().getConnection().write(new ClientboundCookieRequestPacket(resultedKey));
           }
         }, serverConn.ensureConnected().eventLoop());
 
     return true;
   }
 
+  /**
+   * Transforms the recovered frontend AES key into the target key response.
+   *
+   * <p>The frontend handler passes a temporary secret copy to this backend event
+   * loop. This method encrypts that secret and the original target challenge with
+   * the original target key. The target therefore receives the same standard
+   * response that the real client would send.
+   *
+   * <p>The write must complete before this method enables AES. The target reads
+   * the response as plaintext and encrypts its next packet. This order installs
+   * Velocity's decoder before that encrypted packet arrives.
+   *
+   * <p>The frontend and backend use the same key bytes but separate cipher state.
+   * The final block clears the temporary backend copy on every completion path.
+   *
+   * @param secret a temporary copy of the client-generated AES key
+   */
+  public void completeRelayKeyResponse(byte[] secret) {
+    if (secret == null) {
+      logger.error("Cannot build target key response: frontend AES secret is absent");
+      disconnectRelay();
+      return;
+    }
+    if (secret.length != 16) {
+      logger.error(
+          "Cannot build target key response: frontend AES secret is {} bytes; expected 16",
+          secret.length);
+      Arrays.fill(secret, (byte) 0);
+      disconnectRelay();
+      return;
+    }
+
+    try {
+      MinecraftConnection backend = serverConn.ensureConnected();
+      final TargetHello hello = targetHello;
+      if (!backend.eventLoop().inEventLoop()) {
+        logger.error("Cannot build target key response: caller is outside the backend event loop");
+        Arrays.fill(secret, (byte) 0);
+        disconnectRelay();
+        return;
+      }
+      if (resultFuture.isDone()) {
+        logger.error("Cannot build target key response: backend result is already complete");
+        Arrays.fill(secret, (byte) 0);
+        disconnectRelay();
+        return;
+      }
+      if (backend.getActiveSessionHandler() != this) {
+        MinecraftSessionHandler activeHandler = backend.getActiveSessionHandler();
+        logger.error(
+            "Cannot build target key response: active backend handler is {}",
+            activeHandler == null ? "absent" : activeHandler.getClass().getName());
+        Arrays.fill(secret, (byte) 0);
+        disconnectRelay();
+        return;
+      }
+      if (relayResponseWrite != null) {
+        logger.error("Cannot build target key response: relay response write already exists");
+        Arrays.fill(secret, (byte) 0);
+        disconnectRelay();
+        return;
+      }
+      if (hello == null) {
+        logger.error("Cannot build target key response: pending target Hello is absent");
+        Arrays.fill(secret, (byte) 0);
+        disconnectRelay();
+        return;
+      }
+
+      PublicKey targetKey = com.velocitypowered.proxy.crypto.EncryptionUtils
+          .parseRsaPublicKey(hello.publicKey());
+      EncryptionResponsePacket response = new EncryptionResponsePacket(
+          FakePlayerProxyRelay.encryptRsa(targetKey, secret),
+          FakePlayerProxyRelay.encryptRsa(targetKey, hello.challenge()));
+
+      // Wait for the plaintext write. This keeps the first encrypted target packet readable.
+      ChannelFuture write = backend.write(response);
+      if (write == null) {
+        logger.error("Cannot send target key response: backend write returned no future");
+        Arrays.fill(secret, (byte) 0);
+        disconnectRelay();
+        return;
+      }
+      // The write future now owns the response boundary, so the pending Hello can be released.
+      clearTargetHello();
+      this.relayResponseWrite = write;
+      write.addListener(future -> {
+        try {
+          if (!future.isSuccess()) {
+            Throwable cause = future.cause();
+            if (cause == null) {
+              logger.error("Cannot send target key response: backend write failed without a cause");
+            } else {
+              logger.error("Cannot send target key response to the backend", cause);
+            }
+            disconnectRelay();
+            return;
+          }
+          if (resultFuture.isDone()) {
+            logger.error(
+                "Cannot enable backend encryption: backend result completed during response write");
+            disconnectRelay();
+            return;
+          }
+          if (backend.getActiveSessionHandler() != this) {
+            MinecraftSessionHandler activeHandler = backend.getActiveSessionHandler();
+            logger.error(
+                "Cannot enable backend encryption: active backend handler is {}",
+                activeHandler == null ? "absent" : activeHandler.getClass().getName());
+            disconnectRelay();
+            return;
+          }
+          if (relayResponseWrite != write) {
+            logger.error(
+                "Cannot enable backend encryption: response write no longer owns the relay");
+            disconnectRelay();
+            return;
+          }
+          backend.enableEncryption(secret);
+        } catch (GeneralSecurityException | RuntimeException exception) {
+          logger.error("Cannot enable backend encryption after the target response write", exception);
+          disconnectRelay();
+        } finally {
+          Arrays.fill(secret, (byte) 0);
+        }
+      });
+    } catch (GeneralSecurityException | RuntimeException exception) {
+      Arrays.fill(secret, (byte) 0);
+      logger.error("Cannot construct the target key response from the pending Server Hello", exception);
+      disconnectRelay();
+    }
+  }
+
+  /**
+   * Joins the paused target to the frontend configuration stage.
+   *
+   * <p>Target Login Success arrived before Velocity registered the frontend
+   * player. {@link AuthSessionHandler} first finishes LoginEvent, registration,
+   * and PostLogin. {@link ClientConfigSessionHandler} also waits for the client
+   * settings packet. It then calls this method on the backend event loop.
+   *
+   * <p>The method sends Login Acknowledged before it installs the existing target
+   * config handler. It forwards the saved client settings and then resumes target
+   * reads. Existing Velocity configuration code owns every later packet.
+   *
+   * @param settings the settings from the authenticated frontend client
+   */
+  public void resumeRelayConfiguration(ClientSettingsPacket settings) {
+    MinecraftConnection backend = serverConn.ensureConnected();
+    if (backend.getActiveSessionHandler() != this) {
+      MinecraftSessionHandler activeHandler = backend.getActiveSessionHandler();
+      logger.error(
+          "Cannot resume target configuration: active backend handler is {}",
+          activeHandler == null ? "absent" : activeHandler.getClass().getName());
+      disconnectRelay();
+      return;
+    }
+    final ChannelFuture responseWrite = relayResponseWrite;
+    if (!backend.eventLoop().inEventLoop()) {
+      logger.error("Cannot resume target configuration: caller is outside the backend event loop");
+      disconnectRelay();
+      return;
+    }
+    if (resultFuture.isDone()) {
+      logger.error("Cannot resume target configuration: backend result is already complete");
+      disconnectRelay();
+      return;
+    }
+    if (backend.isAutoReading()) {
+      logger.error("Cannot resume target configuration: backend reads are not paused");
+      disconnectRelay();
+      return;
+    }
+    if (responseWrite == null) {
+      logger.error("Cannot resume target configuration: relay response write is absent");
+      disconnectRelay();
+      return;
+    }
+    if (!responseWrite.isSuccess()) {
+      Throwable cause = responseWrite.cause();
+      if (cause == null) {
+        logger.error(
+            "Cannot resume target configuration: relay response write state is {}",
+            responseWrite);
+      } else {
+        logger.error("Cannot resume target configuration: relay response write failed", cause);
+      }
+      disconnectRelay();
+      return;
+    }
+    if (backend.getChannel().pipeline().context(CIPHER_DECODER) == null) {
+      logger.error("Cannot resume target configuration: backend cipher decoder is absent");
+      disconnectRelay();
+      return;
+    }
+
+    relayResponseWrite = null;
+    backend.write(new LoginAcknowledgedPacket());
+    backend.setActiveSessionHandler(
+        StateRegistry.CONFIG, new ConfigSessionHandler(server, serverConn, resultFuture));
+    backend.write(settings);
+    server.getEventManager().fireAndForget(
+        new PlayerEnteredConfigurationEvent(serverConn.getPlayer(), serverConn));
+    backend.setAutoReading(true);
+  }
+
+  /** Closes the backend and completes its result with Velocity's stable connection error. */
+  private void disconnectRelay() {
+    clearTargetHello();
+    relayResponseWrite = null;
+    resultFuture.complete(ConnectionRequestResults.forDisconnect(
+        ConnectionMessages.INTERNAL_SERVER_CONNECTION_ERROR, serverConn.getServer()));
+    serverConn.disconnect();
+  }
+
+  /**
+   * Releases target data after response construction or connection failure.
+   *
+   * <p>The key and challenge are public protocol metadata. Dropping their one
+   * owner prevents stale reuse without treating them as secret AES material.
+   */
+  private void clearTargetHello() {
+    targetHello = null;
+  }
+
   @Override
   public void exception(Throwable throwable) {
+    relayResponseWrite = null;
+    clearTargetHello();
     resultFuture.completeExceptionally(throwable);
   }
 
   @Override
   public void disconnected() {
+    relayResponseWrite = null;
+    clearTargetHello();
     if (server.getConfiguration().getPlayerInfoForwardingMode() == PlayerInfoForwarding.LEGACY) {
       resultFuture.completeExceptionally(new QuietRuntimeException(
               """
               The connection to the remote server was unexpectedly closed.
               This is usually because the remote server does not have \
               BungeeCord IP forwarding correctly enabled.
               See https://docs.papermc.io/velocity/player-information-forwarding for instructions \
               on how to configure player info forwarding correctly."""));
     } else {
       resultFuture.completeExceptionally(
           new QuietRuntimeException("The connection to the remote server was unexpectedly closed.")
       );
     }
   }
+
+  /** Keeps the two values from one target Server Hello under one owner. */
+  private record TargetHello(byte[] publicKey, byte[] challenge) {
+  }
+
 }
