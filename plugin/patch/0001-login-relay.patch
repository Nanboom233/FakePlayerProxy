+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+package com.velocitypowered.proxy.connection.client;
+
+import com.google.common.base.Preconditions;
+import io.netty.buffer.ByteBuf;
+import io.netty.channel.Channel;
+import io.netty.channel.ChannelHandlerContext;
+import io.netty.channel.ChannelInboundHandlerAdapter;
+import io.netty.util.ReferenceCountUtil;
+import org.apache.logging.log4j.LogManager;
+import org.apache.logging.log4j.Logger;
+
+/**
+ * Forwards opaque bytes to one raw tunnel peer.
+ *
+ * <p>The Login bootstrap removes all Minecraft codecs before it adds this
+ * handler. The peer write takes direct ownership of each accepted byte buffer.
+ * This handler also pauses peer reads when this channel cannot accept more
+ * outbound data.
+ *
+ * <p>A channel close or write failure closes the peer. No handler can add a
+ * Minecraft packet after this handoff.
+ */
+final class RawTunnelForwardHandler extends ChannelInboundHandlerAdapter {
+
+  private static final Logger logger = LogManager.getLogger(RawTunnelForwardHandler.class);
+  static final String HANDLER_NAME = "fakeplayerproxy-raw-tunnel";
+
+  private final Channel peer;
+
+  RawTunnelForwardHandler(Channel peer) {
+    this.peer = Preconditions.checkNotNull(peer, "peer");
+  }
+
+  @Override
+  public void channelRead(ChannelHandlerContext context, Object message) {
+    if (!(message instanceof ByteBuf buffer)) {
+      logger.error(
+          "Cannot forward raw tunnel input from channel {}: message type is {}",
+          context.channel(), message == null ? "absent" : message.getClass().getName());
+      ReferenceCountUtil.release(message);
+      closeBoth(context.channel());
+      return;
+    }
+    if (!peer.isActive()) {
+      logger.error(
+          "Cannot write raw tunnel bytes from channel {} to peer {}: peer is inactive",
+          context.channel(), peer);
+      ReferenceCountUtil.release(message);
+      closeBoth(context.channel());
+      return;
+    }
+
+    peer.write(buffer).addListener(future -> {
+      if (!future.isSuccess()) {
+        Throwable cause = future.cause();
+        if (cause == null) {
+          logger.error(
+              "Cannot write raw tunnel bytes from channel {} to peer {}: write failed "
+                  + "without a cause",
+              context.channel(), peer);
+        } else {
+          logger.error(
+              "Cannot write raw tunnel bytes from channel {} to peer {}",
+              context.channel(), peer, cause);
+        }
+        closeBoth(context.channel());
+      }
+    });
+  }
+
+  @Override
+  public void channelReadComplete(ChannelHandlerContext context) {
+    peer.flush();
+  }
+
+  @Override
+  public void channelWritabilityChanged(ChannelHandlerContext context) {
+    setPeerReads(context.channel().isWritable());
+  }
+
+  @Override
+  public void channelInactive(ChannelHandlerContext context) {
+    closeChannel(peer, "peer after source channel " + context.channel() + " closed");
+  }
+
+  @Override
+  public void exceptionCaught(ChannelHandlerContext context, Throwable throwable) {
+    logger.error(
+        "Raw tunnel read failed on channel {} with peer {}",
+        context.channel(), peer, throwable);
+    closeBoth(context.channel());
+  }
+
+  private void setPeerReads(boolean enabled) {
+    if (!peer.eventLoop().inEventLoop()) {
+      peer.eventLoop().execute(() -> setPeerReads(enabled));
+      return;
+    }
+    if (peer.isActive()) {
+      peer.config().setAutoRead(enabled);
+      if (enabled) {
+        peer.read();
+      }
+    }
+  }
+
+  private void closeBoth(Channel source) {
+    closeChannel(source, "source");
+    closeChannel(peer, "peer");
+  }
+
+  private void closeChannel(Channel channel, String side) {
+    if (channel.isActive()) {
+      channel.close().addListener(future -> {
+        if (!future.isSuccess()) {
+          Throwable cause = future.cause();
+          if (cause == null) {
+            logger.error(
+                "Cannot close raw tunnel {} channel {}: close failed without a cause",
+                side, channel);
+          } else {
+            logger.error("Cannot close raw tunnel {} channel {}", side, channel, cause);
+          }
+        }
+      });
+    }
+  }
+}
