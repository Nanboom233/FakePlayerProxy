+
+package com.velocitypowered.proxy.protocol.util;
+
+import static com.velocitypowered.proxy.crypto.EncryptionUtils.parseRsaPublicKey;
+
+import java.io.ByteArrayOutputStream;
+import java.math.BigInteger;
+import java.nio.charset.StandardCharsets;
+import java.security.GeneralSecurityException;
+import java.security.PublicKey;
+import java.security.interfaces.RSAPublicKey;
+import java.util.Arrays;
+import java.util.HexFormat;
+import javax.crypto.Cipher;
+
+/**
+ * Builds and verifies the FakePlayerProxy data in standard login key packets.
+ *
+ * <p>Velocity must give the client two public keys during one login. The client
+ * needs the target key for its Mojang session digest. Velocity needs a proxy key
+ * with a matching private key to recover the client-generated AES key.
+ *
+ * <p>The decorated SPKI solves this conflict. Its subject key contains the proxy
+ * modulus and exponent. Its AlgorithmIdentifier parameter contains the protocol
+ * marker and the original target SPKI. The client returns the AES key through
+ * the standard key response and identifies Mod support in the challenge field.
+ *
+ * <p>This utility owns only the carrier format and RSA transformation. Existing
+ * Velocity handlers still own packet order, connection state, and cipher setup.
+ * This boundary keeps the patch small and makes the byte transformation testable.
+ */
+public final class FakePlayerProxyRelay {
+
+  private static final byte[] MAGIC = "FPPMOD".getBytes(StandardCharsets.US_ASCII);
+  private static final byte[] ACKNOWLEDGEMENT = "FPPACK".getBytes(StandardCharsets.US_ASCII);
+  private static final byte VERSION = 1;
+  private static final int MAX_TARGET_KEY_LENGTH = 512;
+  private static final int MAX_RSA_PLAINTEXT_LENGTH = 117;
+  private static final byte[] RSA_ENCRYPTION_OID =
+      HexFormat.of().parseHex("2A864886F70D010101");
+
+  private FakePlayerProxyRelay() {
+  }
+
+  /**
+   * Builds the public key that Velocity sends in the frontend Server Hello.
+   *
+   * <p>The method keeps the proxy RSA values in the subject key. The client can
+   * therefore encrypt its standard key response for Velocity. The method stores
+   * the target SPKI in the AlgorithmIdentifier parameter. The Mod can therefore
+   * compute the Mojang digest for the real target.
+   *
+   * <p>The method validates the target key before it builds the carrier. It also
+   * parses the result again. This round trip proves that the active JCA provider
+   * keeps the carrier and still provides a usable proxy RSA key.
+   *
+   * <p>SunRsaSign preserves this non-NULL parameter. See
+   * `.trellis/tasks/06-12-fake-player-proxy-research/research/
+   * minecraft-1.20-26.2-spki-carrier-compatibility.md` for the provider evidence.
+   *
+   * @param proxyPublicKey the key that matches Velocity's private key
+   * @param targetPublicKey the original target SPKI
+   * @return a parseable proxy SPKI that also carries the target SPKI
+   * @throws GeneralSecurityException if a key or the provider result is invalid
+   */
+  public static byte[] decoratePublicKey(PublicKey proxyPublicKey, byte[] targetPublicKey)
+      throws GeneralSecurityException {
+    if (!(proxyPublicKey instanceof RSAPublicKey rsaPublicKey)) {
+      String proxyKeyType = proxyPublicKey == null
+          ? "absent"
+          : proxyPublicKey.getClass().getName() + " (" + proxyPublicKey.getAlgorithm() + ")";
+      throw new GeneralSecurityException("Proxy public key type is not RSA: " + proxyKeyType);
+    }
+    if (targetPublicKey == null) {
+      throw new GeneralSecurityException("Target public key is absent");
+    }
+    if (targetPublicKey.length == 0 || targetPublicKey.length > MAX_TARGET_KEY_LENGTH) {
+      throw new GeneralSecurityException(
+          "Target public key encoded length is " + targetPublicKey.length
+              + "; expected 1.." + MAX_TARGET_KEY_LENGTH + " bytes");
+    }
+    parsePublicKey(targetPublicKey, "target");
+
+    // The carrier contains public routing data only. It never contains K or credentials.
+    ByteArrayOutputStream envelope = new ByteArrayOutputStream(
+        MAGIC.length + 1 + 5 + targetPublicKey.length);
+    envelope.writeBytes(MAGIC);
+    envelope.write(VERSION);
+    writeVarInt(envelope, targetPublicKey.length);
+    envelope.writeBytes(targetPublicKey);
+
+    // Keep the proxy RSA values in the subject key. Velocity owns the matching private key.
+    byte[] algorithmIdentifier = derSequence(
+        derValue(0x06, RSA_ENCRYPTION_OID),
+        derValue(0x04, envelope.toByteArray()));
+    byte[] rsaKey = derSequence(
+        derInteger(rsaPublicKey.getModulus()),
+        derInteger(rsaPublicKey.getPublicExponent()));
+    byte[] subjectPublicKey = new byte[rsaKey.length + 1];
+    System.arraycopy(rsaKey, 0, subjectPublicKey, 1, rsaKey.length);
+    byte[] decorated = derSequence(algorithmIdentifier, derValue(0x03, subjectPublicKey));
+
+    // Reject a provider that accepts the key but removes the carrier on re-encoding.
+    PublicKey parsed = parsePublicKey(decorated, "decorated proxy carrier");
+    if (!Arrays.equals(decorated, parsed.getEncoded())) {
+      byte[] parsedEncoding = parsed.getEncoded();
+      throw new GeneralSecurityException(
+          "RSA provider changed decorated proxy key encoding from " + decorated.length
+              + " bytes to " + (parsedEncoding == null ? "absent" : parsedEncoding.length));
+    }
+    return decorated;
+  }
+
+  /**
+   * Identifies whether the frontend response came from Vanilla or the Mod.
+   *
+   * <p>A Vanilla client returns the original target challenge because it does not
+   * know the carrier. The Mod returns the marker, version, and same challenge.
+   * Exact comparison also binds the acknowledgement to this target login.
+   *
+   * @param response the challenge plaintext that Velocity decrypted
+   * @param targetChallenge the challenge from the active target Server Hello
+   * @return the exact response classification
+   */
+  public static ResponseKind classifyResponse(byte[] response, byte[] targetChallenge) {
+    if (response == null || targetChallenge == null) {
+      return ResponseKind.INVALID;
+    }
+    if (Arrays.equals(response, targetChallenge)) {
+      return ResponseKind.VANILLA;
+    }
+    int challengeOffset = ACKNOWLEDGEMENT.length + 1;
+    if (response.length != challengeOffset + targetChallenge.length
+        || response.length > MAX_RSA_PLAINTEXT_LENGTH
+        || !Arrays.equals(
+            response, 0, ACKNOWLEDGEMENT.length,
+            ACKNOWLEDGEMENT, 0, ACKNOWLEDGEMENT.length)
+        || response[ACKNOWLEDGEMENT.length] != VERSION
+        || !Arrays.equals(
+            response, challengeOffset, response.length,
+            targetChallenge, 0, targetChallenge.length)) {
+      return ResponseKind.INVALID;
+    }
+    return ResponseKind.MOD;
+  }
+
+  /**
+   * Encrypts one field for the standard target key response.
+   *
+   * <p>Velocity already provides RSA decryption for frontend packets. It does not
+   * provide the inverse operation needed here. This method lets the backend
+   * handler send the recovered AES key and original challenge to the target.
+   *
+   * @param key the original target public key
+   * @param value the plaintext field
+   * @return the RSA ciphertext for the target
+   * @throws GeneralSecurityException if JCA cannot encrypt the field
+   */
+  public static byte[] encryptRsa(PublicKey key, byte[] value)
+      throws GeneralSecurityException {
+    Cipher cipher = Cipher.getInstance("RSA");
+    cipher.init(Cipher.ENCRYPT_MODE, key);
+    return cipher.doFinal(value);
+  }
+
+  private static PublicKey parsePublicKey(byte[] encoded, String stage)
+      throws GeneralSecurityException {
+    try {
+      return parseRsaPublicKey(encoded);
+    } catch (IllegalArgumentException exception) {
+      throw new GeneralSecurityException("Unable to parse " + stage + " RSA public key", exception);
+    }
+  }
+
+  /*
+   * These DER helpers encode only the selected SPKI shape. They are not a general
+   * ASN.1 implementation. This narrow encoder avoids another server dependency.
+   */
+  private static void writeVarInt(ByteArrayOutputStream output, int value) {
+    do {
+      int current = value & 0x7F;
+      value >>>= 7;
+      output.write(value == 0 ? current : current | 0x80);
+    } while (value != 0);
+  }
+
+  private static byte[] derInteger(BigInteger value) {
+    return derValue(0x02, value.toByteArray());
+  }
+
+  private static byte[] derSequence(byte[]... values) {
+    ByteArrayOutputStream output = new ByteArrayOutputStream();
+    for (byte[] value : values) {
+      output.writeBytes(value);
+    }
+    return derValue(0x30, output.toByteArray());
+  }
+
+  private static byte[] derValue(int tag, byte[] value) {
+    ByteArrayOutputStream output =
+        new ByteArrayOutputStream(2 + Integer.BYTES + value.length);
+    output.write(tag);
+    writeDerLength(output, value.length);
+    output.writeBytes(value);
+    return output.toByteArray();
+  }
+
+  private static void writeDerLength(ByteArrayOutputStream output, int length) {
+    if (length < 128) {
+      output.write(length);
+      return;
+    }
+    int byteCount = Math.ceilDiv(
+        Integer.SIZE - Integer.numberOfLeadingZeros(length), Byte.SIZE);
+    output.write(0x80 | byteCount);
+    for (int shift = (byteCount - 1) * 8; shift >= 0; shift -= 8) {
+      output.write(length >>> shift);
+    }
+  }
+
+  /**
+   * Identifies the client behavior that Velocity observed after RSA decryption.
+   */
+  public enum ResponseKind {
+    /** The client returned the unchanged challenge and did not prove Mod support. */
+    VANILLA,
+    /** The client returned the exact marker, version, and active target challenge. */
+    MOD,
+    /** The client returned a value that belongs to neither accepted flow. */
+    INVALID
+  }
+}
