+  // This future owns the response boundary until the handler enters Configuration.
+  private ChannelFuture relayResponseWrite;
 
   LoginSessionHandler(VelocityServer server, VelocityServerConnection serverConn,
       CompletableFuture<Impl> resultFuture) {
