 /**
  * Handles a player trying to log into the proxy.
+ *
+ * <p>Stock Velocity rejects an online-mode backend because the proxy cannot use
+ * the client's Mojang session. During the initial FakePlayerProxy relay, the
+ * active frontend handler changes that one branch.
+ *
+ * <p>This handler passes the target Server Hello to the frontend. After the Mod
+ * response, it encrypts the recovered AES key and original challenge for the
+ * target. It writes the standard key response before it enables backend AES.
+ *
+ * <p>After target Login Success, this handler pauses target reads and passes the
+ * authenticated profile to the frontend. It resumes the same target connection
+ * after PostLogin and client settings are complete.
+ *
+ * <p>A backend connection outside this initial relay keeps the original Velocity
+ * behavior. This limit prevents relay data from changing normal server
+ * switches or offline backend logins.
  */
 public class LoginSessionHandler implements MinecraftSessionHandler {
 
   private static final Logger logger = LogManager.getLogger(LoginSessionHandler.class);
 
   private static final Component MODERN_IP_FORWARDING_FAILURE =
       Component.translatable("velocity.error.modern-forwarding-failed");
 
   private final VelocityServer server;
   private final VelocityServerConnection serverConn;
   private final CompletableFuture<Impl> resultFuture;
   private boolean informationForwarded;
+  // The target Hello owns its public metadata until the plaintext response takes ownership.
