+import com.velocitypowered.proxy.protocol.StateRegistry;
+import com.velocitypowered.proxy.protocol.packet.DisconnectPacket;
+import com.velocitypowered.proxy.protocol.packet.EncryptionRequestPacket;
+import com.velocitypowered.proxy.protocol.packet.HandshakePacket;
+import com.velocitypowered.proxy.protocol.packet.ServerLoginPacket;
+import io.netty.buffer.ByteBuf;
+import io.netty.channel.Channel;
+import io.netty.channel.ChannelFuture;
+import io.netty.channel.ChannelPipeline;
+import io.netty.channel.EventLoop;
+import java.net.InetSocketAddress;
+import org.apache.logging.log4j.LogManager;
+import org.apache.logging.log4j.Logger;
+
+/**
+ * Owns the plaintext Login Start boundary for one Transfer connection.
+ *
+ * <p>The handshake handler validates the protocol and selects the fixed target.
+ * This handler accepts one Login Start packet and pauses frontend reads. It then
+ * writes a Login handshake and the unchanged Login Start to the target.
+ *
+ * <p>After both writes complete, the target Login decoder reads one Server Hello.
+ * This handler forwards that packet to the paused frontend. Only a successful
+ * frontend write removes both Minecraft codec pipelines. {@link RawTunnelForwardHandler}
+ * then owns all later bytes.
+ */
+final class TransferTunnelLoginSessionHandler implements MinecraftSessionHandler {
+
+  private static final Logger logger =
+      LogManager.getLogger(TransferTunnelLoginSessionHandler.class);
+  private final MinecraftConnection frontend;
+  private final InitialInboundConnection inbound;
+  private final HandshakePacket transferHandshake;
+  private final InetSocketAddress targetAddress;
+  private final TargetConnector targetConnector;
+  private Channel target;
+
+  TransferTunnelLoginSessionHandler(
+      MinecraftConnection frontend,
+      InitialInboundConnection inbound,
+      HandshakePacket transferHandshake,
+      InetSocketAddress targetAddress,
+      TargetConnector targetConnector) {
+    this.frontend = frontend;
+    this.inbound = inbound;
+    this.transferHandshake = transferHandshake;
+    this.targetAddress = targetAddress;
+    this.targetConnector = targetConnector;
+  }
+
+  /**
+   * Accepts one Login Start packet before the raw byte handoff.
+   *
+   * <p>A normal client waits for Server Hello after this packet. Pausing reads
+   * here preserves a complete packet boundary while the target connects.
+   */
+  @Override
+  public boolean handle(ServerLoginPacket packet) {
+    if (target != null) {
+      logger.error(
+          "Cannot accept Transfer Login Start: target channel {} already exists", target);
+      closeBeforeHandoff();
+      return true;
+    }
+
+    frontend.setAutoReading(false);
+    ChannelFuture connectFuture;
+    try {
+      connectFuture = targetConnector.connect(frontend.eventLoop(), targetAddress);
+    } catch (RuntimeException exception) {
+      logger.error("Cannot start raw target connection to {}", targetAddress, exception);
+      closeBeforeHandoff();
+      return true;
+    }
+    if (connectFuture == null) {
+      logger.error("Cannot connect raw target channel to {}: connector returned no future",
+          targetAddress);
+      closeBeforeHandoff();
+      return true;
+    }
+    this.target = connectFuture.channel();
+    connectFuture.addListener(future -> {
+      if (!future.isSuccess()) {
+        Throwable cause = future.cause();
+        if (cause == null) {
+          logger.error(
+              "Cannot connect raw target channel to {}: connect failed without a cause",
+              targetAddress);
+        } else {
+          logger.error("Cannot connect raw target channel to {}", targetAddress, cause);
+        }
+        closeBeforeHandoff();
+        return;
+      }
+
+      if (frontend.isClosed()) {
+        Channel targetChannel = this.target;
+        this.target = null;
+        if (targetChannel == null) {
+          return;
+        }
+        targetChannel.close().addListener(closeFuture -> {
+          if (!closeFuture.isSuccess()) {
+            Throwable cause = closeFuture.cause();
+            if (cause == null) {
+              logger.error(
+                  "Cannot close raw target channel {} after the frontend closed: "
+                      + "close failed without a cause",
+                  targetChannel);
+            } else {
+              logger.error(
+                  "Cannot close raw target channel {} after the frontend closed",
+                  targetChannel, cause);
+            }
+          }
+        });
+        return;
+      }
+      try {
+        writeTargetBootstrap(packet);
+      } catch (RuntimeException exception) {
+        logger.error("Cannot write the raw target handshake and Login Start", exception);
+        closeBeforeHandoff();
+      }
+    });
+    return true;
+  }
+
+  /**
+   * Writes the replacement Login handshake and the unchanged Login Start.
+   *
+   * <p>The first write keeps the protocol, host, and port from the Transfer
+   * handshake. It changes only the intent. The second write preserves every
+   * decoded Login Start field. The write result starts one target read. The target
+   * Server Hello write owns the later raw handoff decision.
+   *
+   * @param loginPacket the Login Start packet from the client
+   */
+  private void writeTargetBootstrap(ServerLoginPacket loginPacket) {
+    Channel targetChannel = target;
+    if (targetChannel == null) {
+      logger.error("Cannot write raw target bootstrap to {}: target channel is absent",
+          targetAddress);
+      closeBeforeHandoff();
+      return;
+    }
+    HandshakePacket targetHandshake = new HandshakePacket();
+    targetHandshake.setProtocolVersion(transferHandshake.getProtocolVersion());
+    targetHandshake.setServerAddress(transferHandshake.getServerAddress());
+    targetHandshake.setPort(transferHandshake.getPort());
+    targetHandshake.setIntent(HandshakeIntent.LOGIN);
+
+    MinecraftConnection targetLogin = new MinecraftConnection(targetChannel, frontend.server);
+    targetChannel.pipeline().addLast(HANDLER, targetLogin);
+    targetLogin.setProtocolVersion(transferHandshake.getProtocolVersion());
+    ChannelFuture handshakeWrite = targetChannel.write(targetHandshake);
+    targetLogin.setActiveSessionHandler(
+        StateRegistry.LOGIN, new TargetLoginSessionHandler(targetChannel));
+    ChannelFuture loginWrite = targetChannel.writeAndFlush(loginPacket);
+    loginWrite.addListener(future -> {
+      if (!handshakeWrite.isSuccess()) {
+        Throwable cause = handshakeWrite.cause();
+        if (cause == null) {
+          logger.error(
+              "Cannot write raw target handshake to {}: write state is {}",
+              targetAddress, handshakeWrite);
+        } else {
+          logger.error("Cannot write raw target handshake to {}", targetAddress, cause);
+        }
+        closeBeforeHandoff();
+        return;
+      }
+      if (!future.isSuccess()) {
+        Throwable cause = future.cause();
+        if (cause == null) {
+          logger.error("Cannot write raw target Login Start to {}: write failed without a cause",
+              targetAddress);
+        } else {
+          logger.error("Cannot write raw target Login Start to {}", targetAddress, cause);
+        }
+        closeBeforeHandoff();
+        return;
+      }
+      // AUTO_READ remains disabled on both channels. Remove the holder before the explicit
+      // transport read; otherwise it queues the response until a second read that never occurs.
+      removeIfPresent(targetChannel.pipeline(), FLOW_HANDLER);
+      targetChannel.read();
+    });
+  }
+
+  /** Owns the decoded target Login response until the raw tunnel takes both channels. */
+  private final class TargetLoginSessionHandler implements MinecraftSessionHandler {
+
+    private final Channel targetChannel;
+    private ChannelFuture helloWrite;
+
+    private TargetLoginSessionHandler(Channel targetChannel) {
+      this.targetChannel = targetChannel;
+    }
+
+    @Override
+    public boolean handle(EncryptionRequestPacket packet) {
+      if (target != targetChannel) {
+        logger.error(
+            "Raw target {} sent Server Hello after Transfer Login ownership changed",
+            targetAddress);
+        targetChannel.close();
+        return true;
+      }
+      if (helloWrite != null) {
+        logger.error(
+            "Raw target {} sent a second Server Hello while waiting for raw handoff",
+            targetAddress);
+        closeBeforeHandoff();
+        return true;
+      }
+      if (frontend.isClosed()) {
+        logger.error(
+            "Cannot forward Server Hello from raw target {}: frontend closed during Transfer Login",
+            targetAddress);
+        closeBeforeHandoff();
+        return true;
+      }
+
+      ChannelFuture write = frontend.write(packet);
+      if (write == null) {
+        logger.error(
+            "Cannot forward Server Hello from raw target {}: frontend write is unavailable",
+            targetAddress);
+        closeBeforeHandoff();
+        return true;
+      }
+      helloWrite = write;
+      write.addListener(future -> {
+        if (target != targetChannel || helloWrite != write) {
+          logger.error(
+              "Cannot finish Server Hello handoff from raw target {}: "
+                  + "Transfer Login ownership changed",
+              targetAddress);
+          targetChannel.close();
+          return;
+        }
+        if (!future.isSuccess()) {
+          Throwable cause = future.cause();
+          if (cause == null) {
+            logger.error(
+                "Cannot forward Server Hello from raw target {}: write failed without a cause",
+                targetAddress);
+          } else {
+            logger.error("Cannot forward Server Hello from raw target {}", targetAddress, cause);
+          }
+          closeBeforeHandoff();
+          return;
+        }
+        if (frontend.isClosed() || !targetChannel.isActive()) {
+          logger.error(
+              "Cannot install raw tunnel for target {} after Server Hello: a channel is closed",
+              targetAddress);
+          closeBeforeHandoff();
+          return;
+        }
+        try {
+          installRawTunnel(frontend.getChannel(), targetChannel);
+          // The raw handlers now own both channels. This Login owner no longer owns the target.
+          target = null;
+        } catch (RuntimeException exception) {
+          logger.error(
+              "Cannot install raw tunnel for target {} after forwarding Server Hello",
+              targetAddress, exception);
+          closeBeforeHandoff();
+        }
+      });
+      return true;
+    }
+
+    @Override
+    public boolean handle(DisconnectPacket packet) {
+      if (target != targetChannel) {
+        return true;
+      }
+      logger.error(
+          "Raw target {} sent Login Disconnect while waiting for Server Hello",
+          targetAddress);
+      target = null;
+      targetChannel.close();
+      if (!frontend.isClosed()) {
+        frontend.closeWith(packet);
+      }
+      return true;
+    }
+
+    @Override
+    public void handleGeneric(MinecraftPacket packet) {
+      logger.error(
+          "Raw target {} sent unexpected {} while waiting for Server Hello",
+          targetAddress, packet.getClass().getSimpleName());
+      closeBeforeHandoff();
+    }
+
+    @Override
+    public void handleUnknown(ByteBuf buffer) {
+      logger.error(
+          "Raw target {} sent {} undecoded bytes while waiting for Server Hello",
+          targetAddress, buffer.readableBytes());
+      closeBeforeHandoff();
+    }
+
+    @Override
+    public void exception(Throwable throwable) {
+      logger.error(
+          "Raw target {} failed while waiting for Server Hello",
+          targetAddress, throwable);
+      closeBeforeHandoff();
+    }
+
+    @Override
+    public void disconnected() {
+      if (target != targetChannel) {
+        return;
+      }
+      logger.error(
+          "Raw target {} closed while waiting for Server Hello",
+          targetAddress);
+      closeBeforeHandoff();
+    }
+  }
+
+  /**
+   * Replaces both packet pipelines with one byte-forwarding handler per channel.
+   *
+   * <p>Both channels have paused reads. The target bootstrap writes have also
+   * completed. Codec removal cannot lose a packet at this boundary. The read
+   * timeout remains on each channel and continues to own idle failures.
+   *
+   * @param frontendChannel the client channel
+   * @param targetChannel the fixed target channel
+   */
+  static void installRawTunnel(Channel frontendChannel, Channel targetChannel) {
+    ChannelPipeline frontendPipeline = frontendChannel.pipeline();
+    removeIfPresent(frontendPipeline, LEGACY_PING_DECODER);
+    removeIfPresent(frontendPipeline, FRAME_DECODER);
+    removeIfPresent(frontendPipeline, MINECRAFT_DECODER);
+    removeIfPresent(frontendPipeline, LEGACY_PING_ENCODER);
+    removeIfPresent(frontendPipeline, FRAME_ENCODER);
+    removeIfPresent(frontendPipeline, MINECRAFT_ENCODER);
+    removeIfPresent(frontendPipeline, HANDLER);
+
+    ChannelPipeline targetPipeline = targetChannel.pipeline();
+    removeIfPresent(targetPipeline, FRAME_DECODER);
+    removeIfPresent(targetPipeline, MINECRAFT_DECODER);
+    removeIfPresent(targetPipeline, FLOW_HANDLER);
+    removeIfPresent(targetPipeline, FRAME_ENCODER);
+    removeIfPresent(targetPipeline, MINECRAFT_ENCODER);
+    removeIfPresent(targetPipeline, HANDLER);
+
+    frontendChannel.pipeline().addLast(
+        RawTunnelForwardHandler.HANDLER_NAME,
+        new RawTunnelForwardHandler(targetChannel));
+    targetChannel.pipeline().addLast(
+        RawTunnelForwardHandler.HANDLER_NAME,
+        new RawTunnelForwardHandler(frontendChannel));
+
+    targetChannel.config().setAutoRead(true);
+    targetChannel.read();
+    frontendChannel.config().setAutoRead(true);
+    frontendChannel.read();
+  }
+
+  private static void removeIfPresent(ChannelPipeline pipeline, String name) {
+    if (pipeline.context(name) != null) {
+      pipeline.remove(name);
+    }
+  }
+
+  /** Closes both channels after the owning validation or catch site records the cause. */
+  private void closeBeforeHandoff() {
+    Channel targetChannel = target;
+    target = null;
+    if (targetChannel != null) {
+      targetChannel.close().addListener(future -> {
+        if (!future.isSuccess()) {
+          Throwable cause = future.cause();
+          if (cause == null) {
+            logger.error(
+                "Cannot close raw target channel {} before handoff: close failed without a cause",
+                targetChannel);
+          } else {
+            logger.error("Cannot close raw target channel {} before handoff",
+                targetChannel, cause);
+          }
+        }
+      });
+    }
+    if (!frontend.isClosed()) {
+      inbound.disconnect(ConnectionMessages.INTERNAL_SERVER_CONNECTION_ERROR);
+    }
+  }
+
+  @Override
+  public void disconnected() {
+    if (target != null) {
+      Channel targetChannel = target;
+      target = null;
+      targetChannel.close().addListener(future -> {
+        if (!future.isSuccess()) {
+          Throwable cause = future.cause();
+          if (cause == null) {
+            logger.error(
+                "Cannot close raw target channel {} after frontend disconnect: "
+                    + "close failed without a cause",
+                targetChannel);
+          } else {
+            logger.error("Cannot close raw target channel {} after frontend disconnect",
+                targetChannel, cause);
+          }
+        }
+      });
+    }
+  }
+
+  @Override
+  public void handleUnknown(ByteBuf buffer) {
+    logger.error(
+        "Cannot continue raw handoff: unexpected pre-handoff buffer has {} readable bytes",
+        buffer.readableBytes());
+    closeBeforeHandoff();
+  }
+
+  @Override
+  public void exception(Throwable throwable) {
+    logger.error("Frontend connection failed before the FakePlayerProxy raw handoff", throwable);
+    closeBeforeHandoff();
+  }
+
+  @FunctionalInterface
+  interface TargetConnector {
+    ChannelFuture connect(EventLoop eventLoop, InetSocketAddress address);
+  }
+}
