+package com.velocitypowered.api.event.connection;
+
+import com.velocitypowered.api.proxy.Player;
+import org.geysermc.mcprotocollib.network.packet.Packet;
+
+/** A synchronous event for one packet received from a player. */
+public final class ServerboundPacketEvent<T extends Packet> {
+  private final Player player;
+  private final Class<T> packetType;
+  private T packet;
+  private boolean cancelled;
+
+  /**
+   * Creates a serverbound packet event.
+   *
+   * @param player the sending player
+   * @param packetType the registered packet type
+   * @param packet the decoded packet
+   */
+  public ServerboundPacketEvent(Player player, Class<T> packetType, T packet) {
+    this.player = player;
+    this.packetType = packetType;
+    this.packet = packet;
+  }
+
+  public Player getPlayer() {
+    return player;
+  }
+
+  public T getPacket() {
+    return packet;
+  }
+
+  public void setPacket(T packet) {
+    this.packet = packetType.cast(packet);
+  }
+
+  public void cancel() {
+    cancelled = true;
+  }
+
+  public boolean isCancelled() {
+    return cancelled;
+  }
+}
