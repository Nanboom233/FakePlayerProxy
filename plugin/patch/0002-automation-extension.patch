+  /**
+   * Deep-copies an explicit command graph into the destination.
+   *
+   * @param origin the root node to copy from
+   * @param dest the root node to copy into
+   */
+  public void copy(final RootCommandNode<S> origin, final RootCommandNode<S> dest) {
+    lock.lock();
+    try {
+      final Map<CommandNode<S>, CommandNode<S>> done = new IdentityHashMap<>();
+      done.put(origin, dest);
+      final Set<CommandNode<S>> nodes = Collections.newSetFromMap(new IdentityHashMap<>());
+      final ArrayDeque<CommandNode<S>> pending = new ArrayDeque<>();
+      pending.add(origin);
+      while (!pending.isEmpty()) {
+        final CommandNode<S> node = pending.remove();
+        if (nodes.add(node)) {
+          pending.addAll(node.getChildren());
+          if (node.getRedirect() != null) {
+            pending.add(node.getRedirect());
+          }
+        }
+      }
+      for (final CommandNode<S> node : nodes) {
+        this.copyNode(node, done, Collections.newSetFromMap(new IdentityHashMap<>()));
+      }
+      for (final CommandNode<S> node : nodes) {
+        final CommandNode<S> copy = done.get(node);
+        for (final CommandNode<S> child : node.getChildren()) {
+          copy.addChild(done.get(child));
+        }
+      }
+    } finally {
+      lock.unlock();
+    }
+  }
+
+  private CommandNode<S> copyNode(final CommandNode<S> node,
+                                  final Map<CommandNode<S>, CommandNode<S>> done,
+                                  final Set<CommandNode<S>> visiting) {
+    final CommandNode<S> existing = done.get(node);
+    if (existing != null) {
+      return existing;
+    }
+    if (!visiting.add(node)) {
+      throw new IllegalStateException("Command redirect cycle detected");
+    }
+    final ArgumentBuilder<S, ?> builder = node.createBuilder();
+    if (node.getRedirect() != null) {
+      builder.forward(this.copyNode(node.getRedirect(), done, visiting),
+          builder.getRedirectModifier(), builder.isFork());
+    }
+    final CommandNode<S> copy = builder.build();
+    done.put(node, copy);
+    visiting.remove(node);
+    return copy;
+  }
