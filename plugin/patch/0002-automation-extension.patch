+package com.velocitypowered.proxy.event;
+
+import com.velocitypowered.api.event.connection.ClientboundPacketEvent;
+import com.velocitypowered.api.event.connection.ServerboundPacketEvent;
+import com.velocitypowered.api.proxy.Player;
+import java.util.List;
+import org.geysermc.mcprotocollib.network.packet.Packet;
+
+/** Immutable synchronous dispatch data for one concrete packet type. */
+public final class PacketEventHandler {
+  private final boolean serverbound;
+  private final Class<? extends Packet> packetType;
+  private final List<VelocityEventManager.HandlerRegistration> registrations;
+
+  /**
+   * Creates immutable dispatch data for one packet type.
+   *
+   * @param serverbound whether packets travel from client to server
+   * @param packetType the concrete packet type
+   * @param registrations the synchronous handlers in dispatch order
+   */
+  PacketEventHandler(boolean serverbound, Class<? extends Packet> packetType,
+      List<VelocityEventManager.HandlerRegistration> registrations) {
+    this.serverbound = serverbound;
+    this.packetType = packetType;
+    this.registrations = List.copyOf(registrations);
+  }
+
+  /**
+   * Returns the concrete packet type handled by this dispatch entry.
+   *
+   * @return the packet type
+   */
+  public Class<? extends Packet> packetType() {
+    return packetType;
+  }
+
+  /**
+   * Dispatches one packet through the registered synchronous handlers.
+   *
+   * @param player the associated player
+   * @param packet the decoded packet
+   * @return the original or replacement packet, or {@code null} when cancelled
+   */
+  public Packet dispatch(Player player, Packet packet) {
+    Object event = serverbound
+        ? new ServerboundPacketEvent<>(player, castPacketType(), packetType.cast(packet))
+        : new ClientboundPacketEvent<>(player, castPacketType(), packetType.cast(packet));
+    boolean failed = false;
+    for (VelocityEventManager.HandlerRegistration registration : registrations) {
+      try {
+        registration.handler.executeAsync(event);
+      } catch (Throwable throwable) {
+        VelocityEventManager.logHandlerException(registration, throwable);
+        failed = true;
+      }
+    }
+    if (failed) {
+      return packet;
+    }
+    if (event instanceof ServerboundPacketEvent<?> c2s && c2s.isCancelled()) {
+      return null;
+    }
+    return event instanceof ServerboundPacketEvent<?> c2s ? c2s.getPacket()
+        : ((ClientboundPacketEvent<?>) event).getPacket();
+  }
+
+  @SuppressWarnings("unchecked")
+  private Class<Packet> castPacketType() {
+    return (Class<Packet>) packetType;
+  }
+}
+}
